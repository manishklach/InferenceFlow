DATABASE_URL=postgresql+psycopg://inferenceflow:localdev@localhost:55432/inferenceflow
ENVIRONMENT=development
SECRET_KEY=development-only-change-before-deployment
WORKER_BOOTSTRAP_TOKEN=local-worker-only
# Optional locally; required outside development. Protect /metrics with a separate random token.
METRICS_TOKEN=
# Independent random >=32-character key. Prior HMAC keys allow lazy credential migration.
CREDENTIAL_HASH_KEY=
CREDENTIAL_HASH_PREVIOUS_KEYS=[]
# JSON map of key IDs to Fernet.generate_key() values. Required outside development.
ENCRYPTION_KEYS={}
ENCRYPTION_ACTIVE_KEY=
# Retain the old application secret temporarily when migrating legacy ciphertext.
ENCRYPTION_LEGACY_SECRET=
EXECUTION_MODE=mock
# Optional mock-only delay to make queued/running transitions visible in demos.
MOCK_LATENCY_SECONDS=0.01
MODEL_REPO=Qwen/Qwen3-4B
MODEL_REVISION=mock-v1
INPUT_RATE=100000
OUTPUT_RATE=300000
PUBLIC_BETA_ENABLED=false
PROVISIONING_ENABLED=false
MAX_ACTIVE_GPUS=1
MAX_DAILY_GPU_SPEND_USD=25
MAX_GPU_SESSION_MINUTES=120
IDLE_SHUTDOWN_SECONDS=900
RUNPOD_API_KEY=
STRIPE_ENABLED=false
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
DASHBOARD_URL=http://localhost:3000
OIDC_ISSUER=
OIDC_AUDIENCE=
OIDC_JWKS_URL=
CONTROL_PLANE_URL=http://localhost:8080
VLLM_URL=http://127.0.0.1:8000
VLLM_API_KEY=
WORKER_ID=local-worker

OIDC_AUTHORIZATION_URL=
OIDC_TOKEN_URL=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=http://localhost:3000/api/auth/oidc/callback

# Optional: install .[observability] before enabling
OTEL_EXPORTER_OTLP_ENDPOINT=
PROVIDER_INSTANCE_ID=

# v0.3 opt-in scheduling. Both false restores legacy dispatch and tier defaults.
SCHEDULER_V2_ENABLED=false
ADAPTIVE_DISPATCH_ENABLED=false
DEFAULT_COMPLETION_TARGET_SECONDS=3600
ESTIMATOR_INPUT_TOKENS_PER_SECOND=100
ESTIMATOR_OUTPUT_TOKENS_PER_SECOND=20
ESTIMATOR_UNCERTAINTY_MARGIN=1.5
ESTIMATOR_MIN_SAMPLES=20
# Enable only after real GPU calibration; never for mock/simulation results.
ESTIMATOR_CALIBRATED=false
GPU_STARTUP_SECONDS=180
MODEL_LOADING_SECONDS=120
# Separately measured actual weight-load duration; zero means not recorded.
WORKER_MODEL_LOADING_SECONDS=0
TELEMETRY_STALE_SECONDS=45
ADAPTIVE_INITIAL_SLOTS=2
ADAPTIVE_COOLDOWN_SECONDS=30
# Hypothetical quote for recommendations, not verified provider pricing.
PLANNING_HOURLY_MICRO_USD=1000000
PROVIDER_BILLING_INCREMENT_SECONDS=60
