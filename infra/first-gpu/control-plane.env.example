# REVIEW ONLY. Apply to a separate experiment control plane after authorization.
ENVIRONMENT=staging
EXECUTION_MODE=vllm
MODEL_REPO=Qwen/Qwen3-4B
MODEL_REVISION=1cfa9a7208912126459214e8b04321603b3df60c
PUBLIC_BETA_ENABLED=false
REVIEWED_GPU_EXPERIMENT_ENABLED=true
PROVISIONING_ENABLED=false
STRIPE_ENABLED=false
MAX_ACTIVE_GPUS=1
MAX_DAILY_GPU_SPEND_USD=10
MAX_GPU_SESSION_MINUTES=120
PROVIDER_BILLING_INCREMENT_SECONDS=1
SCHEDULER_V2_ENABLED=true
ADAPTIVE_DISPATCH_ENABLED=false
DEFAULT_COMPLETION_TARGET_SECONDS=3600
ESTIMATOR_CALIBRATED=false
MAX_INFLIGHT=4
WORKER_CAPACITY=4
# These are planning inputs, NOT observed GPU throughput or load times.
PLANNING_HOURLY_MICRO_USD=340000
# Required existing private HTTPS identity/database/encryption/metrics/bootstrap
# configuration is intentionally absent. Do not replace a working .env with this file.
# Platform GPU accounting caps omit storage/tax and are not a provider hard limit.
